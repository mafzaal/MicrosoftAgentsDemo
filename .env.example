# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and will never be committed.
#
# Usage (bash/zsh):
#   cp .env.example .env
#   # edit .env with your values, then:
#   export $(grep -v '^#' .env | xargs)
#
# PowerShell:
#   Get-Content .env | Where-Object { $_ -notmatch '^#' } |
#     ForEach-Object { $k,$v = $_ -split '=',2; [System.Environment]::SetEnvironmentVariable($k,$v) }

# Your Azure OpenAI resource endpoint (Azure Portal > Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/

# The model deployment name (e.g. gpt-4o, gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# API key — leave blank to use DefaultAzureCredential (az login / Managed Identity).
# When blank, your identity must have the "Cognitive Services OpenAI User" RBAC role.
AZURE_OPENAI_API_KEY=
