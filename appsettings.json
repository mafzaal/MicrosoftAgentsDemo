{
  "AzureOpenAI": {
    // Your Azure OpenAI resource endpoint — find it in Azure Portal > Keys and Endpoint.
    // You can also set this via the AZURE_OPENAI_ENDPOINT environment variable.
    "Endpoint": null,
    // The model deployment name you created in Azure AI Foundry / Azure OpenAI Studio.
    // You can also set this via the AZURE_OPENAI_DEPLOYMENT_NAME environment variable.
    "DeploymentName": null
    // API key is intentionally omitted here — set AZURE_OPENAI_API_KEY as an
    // environment variable (or use .env) to keep secrets out of source control.
    // Omit the key entirely to use DefaultAzureCredential (az login / Managed Identity).
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}